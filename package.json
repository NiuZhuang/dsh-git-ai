{
  "name": "dsh-git-ai",
  "description": "DeepSeek Harness plugin that records agent edits with git-ai (agent-v1 checkpoints)",
  "version": "0.1.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/invariant.js",
    "lib/invariant.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NiuZhuang/dsh-git-ai.git"
  },
  "bugs": {
    "url": "https://github.com/NiuZhuang/dsh-git-ai/issues"
  },
  "homepage": "https://github.com/NiuZhuang/dsh-git-ai",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  }
}
